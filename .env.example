# Copy to .env and fill in the values.
# .env is gitignored; .env.example is the template tracked in source control.

# ---- Supabase ----
# Project: kkynqbobjjmqgntleqlg
VITE_SUPABASE_URL=https://kkynqbobjjmqgntleqlg.supabase.co
# Use the publishable key (sb_publishable_...) for new code; the legacy
# anon JWT also works if any older code still expects it. Both come from
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_ANON_KEY=

# ---- Server-only (NO VITE_ prefix → never shipped to the client bundle) ----
# Leave blank in source control; set the real value in Vercel / local .env.
ANTHROPIC_API_KEY=
# Supabase service-role JWT. Used only by webhook / server code to bypass
# RLS when writing Stripe subscription state to public.cafes. NEVER expose
# to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe restricted API key (rk_...). Use a Restricted Key with least-
# privilege scopes, not a full secret key. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# Webhook signing secret. From `stripe listen` for local dev, or the
# endpoint's signing secret in Dashboard → Webhooks for prod.
STRIPE_WEBHOOK_SECRET=

# ---- Stripe (client-safe) ----
# Publishable key (pk_...) is safe to ship to the browser.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---- Feature flags ----
# Flip to 'true' to route the onboarding AI flows through the real /api backend.
# Leave unset/false to use the built-in simulated services (rollback path).
VITE_USE_REAL_AI=false
